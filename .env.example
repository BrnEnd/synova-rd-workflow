# Aplicacao local
APP_PORT=8080
LOG_LEVEL=INFO
NLP_CONTEXT_WINDOW=10

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# Prompt opcional para customizar o resumo executivo de negociacoes
DEAL_SUMMARY_PROMPT_TEMPLATE=

# RD Station CRM
RDSTATION_TOKEN=

# DynamoDB
DYNAMODB_TABLE_NAME=synova-rd-workflow-conversations
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=

# Evolution API local
EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_API_KEY=change-me-local-key
EVOLUTION_INSTANCE=synova
EVOLUTION_ALLOWED_NUMBERS=+5500000000000

# Admin local
ADMIN_EMAIL=admin@synova.local
# Se vazio, o app cria o primeiro acesso com a senha temporaria ChangeMe#2026
ADMIN_INITIAL_PASSWORD_HASH=
ADMIN_ORIGIN=http://localhost:3002
ADMIN_COOKIE_SECURE=false
ALERT_CHECK_INTERVAL=30m
# Atraso entre envios WhatsApp via Evolution para reduzir risco de bloqueio
EVOLUTION_SEND_DELAY=10s
