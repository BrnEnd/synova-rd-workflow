aws_region               = "us-east-1"
lambda_memory_size       = 512
dynamodb_read_capacity   = 1
dynamodb_write_capacity  = 1
api_throttle_burst_limit = 5
api_throttle_rate_limit  = 2
whatsapp_access_token    = ""
whatsapp_phone_number_id = ""
whatsapp_verify_token    = ""
whatsapp_app_secret      = ""
evolution_base_url       = ""
evolution_api_key        = ""
evolution_instance       = "synova"
evolution_allowed_numbers = ""
evolution_ecs_instance_type = "t3.micro"
evolution_root_volume_size  = 30
evolution_postgres_password = ""
openai_api_key           = ""
openai_model             = "gpt-5.4-nano"
rdstation_token          = ""
log_level                = "INFO"
nlp_context_window       = 10
admin_email              = "admin@synova.local"
admin_origin             = ""
admin_cookie_secure      = false
alert_check_interval     = "30m"
evolution_send_delay     = "0s"
# Generate once with: go run ./cmd/genkey/main.go
# and store the output here. Never leave empty in production.
admin_jwt_private_key    = ""
